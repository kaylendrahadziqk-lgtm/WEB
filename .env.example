# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAJAONGKIR Configuration
# Dapatkan API Key gratis atau berbayar di https://rajaongkir.com atau https://komerce.id
RAJAONGKIR_API_KEY=""
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"
RAJAONGKIR_ORIGIN_CITY_ID="153" # ID Kota Jakarta Selatan (Default toko)

# AUSTINPAY PAYMENT GATEWAY Configuration
# Dokumentasi resmi: https://www.austinx.cloud/api-docs
# Dapatkan API Key di https://austinstore.id (Profil -> API Key)
# Jangan lupa daftarkan IP server di Whitelist IP pada dashboard AustinPay
AUSTIN_API_KEY="apg_live_0733540cc4e69c1aa1888463236fe92dca7830818253d8d4"
AUSTIN_API_SECRET="aps_5da3e08ed747bf9af46aee49314541e148d258d53449046b9b6161c945fef34e"
AUSTIN_BASE_URL="https://austinstore.id"

# Database & Auth Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/nusastore"
AUTH_SECRET="secret_auth_token_nusastore_2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
